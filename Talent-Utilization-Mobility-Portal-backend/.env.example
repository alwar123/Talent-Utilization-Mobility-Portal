# SkillSphere Employee Backend — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB (dual connections) ─────────────────────────────────────────────────
# Employee data lives here
MONGODB_URI_EMPLOYEE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillsphere_employee

# Jobs and Assessments — shared with the HR side
MONGODB_URI_ADMIN=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillsphere_admin

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Cloudinary (resume / photo storage) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Service ─────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Email (Phase 5 — assessment notifications) ────────────────────────────────
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
