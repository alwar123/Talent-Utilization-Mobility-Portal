{
  "name": "skillsphere-backend",
  "version": "1.0.0",
  "description": "SkillSphere Employee Backend — Node.js / Express",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:admin": "node src/index.js",
