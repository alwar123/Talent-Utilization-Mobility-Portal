# SkillSphere AI Service — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.

# ── Groq (LLM inference) ───────────────────────────────────────────────────────
# Get a free key at: console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Pinecone (cloud vector store) ─────────────────────────────────────────────
# Get a free key at: app.pinecone.io
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
# Index name — must match what you created in the Pinecone console
PINECONE_INDEX_NAME=skillsphere-employees

# ── GitHub (Phase 6 — repo scraper) ───────────────────────────────────────────
# Fine-grained PAT with read:user + public_repo scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
